{
  // Static assets only. A spoke is an ordinary web app; it runs no connectome code
  // of its own. The bridge arrives from the gateway origin (edge injection in
  // production, a plain <script> tag here).
  "name": "stub-notes",
  "compatibility_date": "2026-08-04",
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application"
  },

  "env": {
    "production": {
      "name": "stub-notes",
      "workers_dev": false,
      "routes": [{ "pattern": "tick.example.com", "custom_domain": true }],
      "assets": {
        "directory": "./public",
        "not_found_handling": "single-page-application"
      }
    }
  }
}
