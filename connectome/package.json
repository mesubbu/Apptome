{
  "name": "connectome",
  "version": "0.0.0",
  "private": true,
  "description": "Any opted-in app is accessible from inside any other opted-in app.",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:crm": "pnpm --filter stub-crm dev",
    "dev:invoicing": "pnpm --filter stub-invoicing dev",
    "dev:notes": "pnpm --filter stub-notes dev",
    "dev:surface": "pnpm --filter surface dev",
    "dev:gateway": "pnpm --filter gateway dev",
    "dev:mapper": "pnpm --filter mapper dev",
    "sync": "node scripts/sync-bridge.mjs && node scripts/build-env.mjs",
    "check": "pnpm sync && node ci/distortion-tests.mjs && node ci/provide-context.mjs && vitest run",
    "test": "vitest run",
    "test:e2e": "node ci/e2e-runner.mjs",
    "deploy": "node scripts/deploy.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.98.0"
  },
  "packageManager": "pnpm@10.30.3",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
