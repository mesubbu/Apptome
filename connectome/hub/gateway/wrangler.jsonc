{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "connectome-gateway",
  "main": "src/index.js",
  "compatibility_date": "2026-08-04",
  "observability": { "enabled": true },

  // The bridge sources are served verbatim to every spoke, so they are imported
  // as text rather than bundled. `pnpm sync` refreshes them from packages/.
  "rules": [{ "type": "Text", "globs": ["**/*.js.txt"], "fallthrough": false }],

  "durable_objects": {
    "bindings": [{ "name": "HUB", "class_name": "HubDO" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["HubDO"] }],

  // ------------------------------------------------------------------
  // PAIRING (src/pairing.js). A connectome is one user's own sessions, so the
  // Durable Object must not be addressable by guessing its name.
  //
  // SECRETS — set with `wrangler secret put <NAME>`. NEVER add these to "vars":
  // a var is plaintext in this file and therefore in git, and these two are the
  // entire strength of the door.
  //
  //   TURNSTILE_SECRET   Server half of the Turnstile keypair. Only siteverify
  //                      ever sees it; the widget's own result is not evidence.
  //   PAIR_SECRET        HMAC-SHA256 key that signs minted connectome ids.
  //                      Rotating it un-pairs every browser, which is the
  //                      correct blast radius for a leak.
  //
  // Without either one the gateway refuses to mint, and every id-gated route
  // answers 401 PAIRING_REQUIRED. It fails CLOSED: a half-configured deploy
  // hands out nothing rather than handing out everything.
  //
  // PUBLIC, so these are vars rather than secrets:
  //
  //   TURNSTILE_SITE_KEY    Client half. It is rendered into the widget and is
  //                         served to the surface by GET /api/pair.
  //   ENVIRONMENT           "local" enables the unauthenticated ?cx= / header /
  //                         "local-dev" fallback that `pnpm dev` relies on. Any
  //                         other value — INCLUDING UNSET — is production and
  //                         has no fallback. scripts/dev.mjs passes it.
  //   PAIR_COOKIE_SAMESITE  Defaults to Lax, which is right when the hub, the
  //                         surface and the spokes share one registrable
  //                         domain. A genuinely cross-site mesh needs "None"
  //                         and is then subject to third-party cookie blocking
  //                         — which is why the extension transport exists.
  //
  // §10: Turnstile is request-scoped and human-present. It runs because someone
  // clicked, it authorises addressing your own graph and nothing else, and it
  // grants no write. It is not the "Global 'allow this agent'" that §10 rejects;
  // per-edge consent is untouched and every write still confirms exact JSON.
  // ------------------------------------------------------------------
  "vars": {
    "ENVIRONMENT": "production"
  },

  // ------------------------------------------------------------------
  // KV — short-TTL cache of /.well-known/connectome.json (REVIEW.md G4).
  //
  // Read-through on a user-initiated declare. No background refresh. A miss
  // or a failed put degrades to a live fetch; the declare still works.
  // `id` is omitted so wrangler can provision the namespace on first deploy
  // and so `pnpm dev` still needs no Cloudflare account.
  // ------------------------------------------------------------------
  "kv_namespaces": [
    { "binding": "MANIFESTS" }
  ],

  // ------------------------------------------------------------------
  // Rate Limiting (REVIEW.md G6). Keyed in code by connectome id (or Origin
  // before pairing), never by IP. Two bindings because POST /api/pair mints
  // an id and needs a tighter bucket than a graph read.
  //
  // period must be 10 or 60. Missing/throwing limiter degrades to allow, so
  // the local mesh still boots with no extra config.
  // ------------------------------------------------------------------
  "ratelimits": [
    {
      "name": "RATE_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 10 }
    },
    {
      "name": "PAIR_LIMIT",
      "namespace_id": "1002",
      "simple": { "limit": 8, "period": 60 }
    }
  ],

  // ------------------------------------------------------------------
  // Analytics Engine (REVIEW.md G9). HubDO.#audit writes hashed (kind, edge,
  // outcome, bytes). Dataset is created on first write. A failure degrades;
  // the SQLite audit row is what the user can still export.
  // ------------------------------------------------------------------
  "analytics_engine_datasets": [
    { "binding": "METRICS", "dataset": "connectome-audit" }
  ],

  // Production custom domains. Bindings are not inherited — they are restated.
  // Replace example.com with CONNECTOME_ZONE (docs/topology.md). scripts/deploy.mjs
  // also passes SURFACE_ORIGIN / ALLOWED_ORIGINS so a leftover placeholder cannot
  // silently keep localhost on the public allowlist.
  "env": {
    "production": {
      "name": "connectome-gateway",
      "workers_dev": false,
      "routes": [{ "pattern": "hub.example.com", "custom_domain": true }],
      "vars": {
        "ENVIRONMENT": "production",
        "SURFACE_ORIGIN": "https://surface.example.com",
        "ALLOWED_ORIGINS": "https://crm.example.com,https://ledger.example.com,https://tick.example.com"
      },
      "rules": [{ "type": "Text", "globs": ["**/*.js.txt"], "fallthrough": false }],
      "durable_objects": {
        "bindings": [{ "name": "HUB", "class_name": "HubDO" }]
      },
      "kv_namespaces": [{ "binding": "MANIFESTS" }],
      "ratelimits": [
        { "name": "RATE_LIMIT", "namespace_id": "1001", "simple": { "limit": 60, "period": 10 } },
        { "name": "PAIR_LIMIT", "namespace_id": "1002", "simple": { "limit": 8, "period": 60 } }
      ],
      "analytics_engine_datasets": [{ "binding": "METRICS", "dataset": "connectome-audit" }]
    }
  }

  // DELIBERATELY ABSENT, and CI enforces their absence (ci/distortion-tests.mjs):
  //
  //   browser            Browser Rendering. GrokVision.md §10 rejects a cloud
  //                      headless browser as "the real connectome" — it is a robot
  //                      logging in as you, not your own session. Tools run in the
  //                      user's own tab, in the user's own session, or not at all.
  //   triggers.crons     A cron makes the hub act without the user. GrokVision.md
  //                      §6.2: unattended overnight runs are another product.
  //   queues, workflows  Both exist to run work later, unattended. Same reason.
  //
  // Each of these is one line away. That is exactly why the absence is a test and
  // not a comment.
}
