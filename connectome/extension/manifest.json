{
  "manifest_version": 3,
  "name": "Connectome",
  "version": "0.0.1",
  "description": "Thin on-device hub transport. No mapping, no policy, no graph UI.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": ["storage"],
  "background": { "service_worker": "sw.js", "type": "module" },
  "host_permissions": [
    "http://localhost:8787/*",
    "http://localhost:8788/*",
    "http://localhost:8789/*",
    "http://localhost:8790/*",
    "http://localhost:8791/*"
  ],
  "externally_connectable": {
    "matches": ["http://localhost:8790/*"]
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:8787/*",
        "http://localhost:8788/*",
        "http://localhost:8789/*"
      ],
      "js": ["page-flag.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "http://localhost:8787/*",
        "http://localhost:8788/*",
        "http://localhost:8789/*"
      ],
      "js": ["isolated.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["boot.js", "vendor/*", "protocol/*"],
      "matches": [
        "http://localhost:8787/*",
        "http://localhost:8788/*",
        "http://localhost:8789/*"
      ]
    }
  ]
}
